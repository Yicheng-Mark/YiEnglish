{
  "name": "lingoforge",
  "private": true,
  "version": "0.0.0",
  "description": "英语学习闭环平台 — 输入→理解→训练→应用→反馈",
  "author": "小月",
  "type": "module",
  "browserslist": [
    "defaults",
    "iOS >= 12",
    "Safari >= 12"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dict:cleanup": "node scripts/remove-sentences.mjs",
    "dict:validate": "node scripts/validate-dicts.mjs",
    "dict:levels": "node scripts/validate-levels.mjs",
    "dict:check": "npm run dict:cleanup && npm run dict:validate && npm run dict:levels",
    "add:cntitle": "node scripts/add-cnTitle.mjs",
    "server": "node server/index.js",
    "corpus:check-yt": "node scripts/check-youtube-dup.mjs",
    "dev:all": "concurrently \"npm run dev\" \"npm run server\""
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.24",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.14.0",
    "mysql2": "^3.22.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.22.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.12.3",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@vitejs/plugin-legacy": "^5.4.3",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.2.1",
    "core-js": "^3.49.0",
    "playwright": "^1.60.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "terser": "^5.48.0",
    "vite": "^5.0.0"
  }
}
