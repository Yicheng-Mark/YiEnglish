# ===== 前端（VITE_ 前缀，会被打包进客户端代码）=====

# 后端 API 地址
# 本地开发：留空（走 Vite proxy）
# Vercel 预览：https://dev-api.lingoforge.fun
# 阿里云正式：留空（前后端同域）
VITE_API_BASE_URL=

# OSS 视频访问地址（留空 = 用 mockCorpusVideos.js 里的默认域名回退）
# 留意：OSS 默认域名 xxx.aliyuncs.com 会被强制注入 Content-Disposition: attachment，
# iOS Safari 无法在 <video> 内嵌播放。彻底解决要在 OSS 控制台绑定自定义域名（如
# videos.lingoforge.fun：CNAME → bucket 外网域名 + 上传 HTTPS 证书）并验证可访问后，
# 再把本变量设为该自定义域名（或改 mockCorpusVideos.js 的回退值）。绑定前请保持留空。
VITE_OSS_BASE_URL=

# ===== 后端（不暴露给客户端）=====


# JWT
JWT_SECRET=
# Access token 有效期：缩短可减小 token 被盗用后的窗口；过期后前端自动用 refresh 续期，用户无感
JWT_ACCESS_EXPIRES=30m
# Refresh token 有效期（决定会话最长寿命与 cookie maxAge）
JWT_REFRESH_EXPIRES=7d
# 每账号同时登录设备上限（第 N+1 台登录会被拒绝）
MAX_DEVICES_PER_USER=2

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lingoforge

# Resend（邮件验证码）
RESEND_API_KEY=

# DeepSeek（AI 助手）
# API Key：https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=
# API 地址（默认官方地址，一般不用改）
DEEPSEEK_API_BASE=https://api.deepseek.com
# 模型名（deepseek-chat 会路由到最新的 V 系列对话模型）
DEEPSEEK_MODEL=deepseek-chat

# Server
PORT=3001

# 前端 URL（本地开发用）
FRONTEND_URL=http://localhost:5173

# CORS 白名单（逗号分隔，Vercel 预览阶段使用）
# 例：ALLOWED_ORIGINS=https://xxx.vercel.app,https://yyy.vercel.app
ALLOWED_ORIGINS=
