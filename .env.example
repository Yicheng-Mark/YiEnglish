# ===== 前端（VITE_ 前缀，会被打包进客户端代码）=====

# 后端 API 地址
# 本地开发：留空（走 Vite proxy）
# Vercel 预览：https://dev-api.lingoforge.fun
# 阿里云正式：留空（前后端同域）
VITE_API_BASE_URL=

# OSS 基础地址（默认阿里云 OSS bucket）
VITE_OSS_BASE_URL=https://lingoforge-videos.oss-cn-shenzhen.aliyuncs.com

# ===== 后端（不暴露给客户端）=====

# DeepSeek API
DEEPSEEK_API_KEY=

# JWT
JWT_SECRET=

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lingoforge

# Resend（邮件验证码）
RESEND_API_KEY=

# Server
PORT=3001

# 前端 URL（本地开发用）
FRONTEND_URL=http://localhost:5173

# CORS 白名单（逗号分隔，Vercel 预览阶段使用）
# 例：ALLOWED_ORIGINS=https://xxx.vercel.app,https://yyy.vercel.app
ALLOWED_ORIGINS=
